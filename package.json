{
  "name": "project-phoenix",
  "private": true,
  "description": "Project Phoenix monorepo root (npm workspaces). Node.js runs only inside the pinned toolchain and runtime containers; nothing is installed on the host.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check:pins": "tsc -b && node packages/discovery-loop/dist/tools/checkPins.js"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
