    { "id": "eq_strings", "expr": { "op": "eq", "left": { "op": "input", "path": "requests[0].body.label" }, "right": { "op": "lit", "value": "x" } }, "expect": { "ok": true, "value": true } },
    { "id": "ne_strings_differ", "expr": { "op": "ne", "left": { "op": "lit", "value": "a" }, "right": { "op": "lit", "value": "b" } }, "expect": { "ok": true, "value": true } },
    { "id": "eq_real_operand_is_type_error", "expr": { "op": "eq", "left": { "op": "input", "path": "requests[0].body.ratio" }, "right": { "op": "input", "path": "requests[0].body.ratio" } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/left" } } },
    { "id": "ne_real_right_operand_is_type_error", "expr": { "op": "ne", "left": { "op": "lit", "value": 1 }, "right": { "op": "input", "path": "requests[0].body.ratio" } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/right" } } },

    { "id": "lt_true", "expr": { "op": "lt", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 2 } }, "expect": { "ok": true, "value": true } },
    { "id": "lt_equal_false", "expr": { "op": "lt", "left": { "op": "lit", "value": 2 }, "right": { "op": "lit", "value": 2 } }, "expect": { "ok": true, "value": false } },
