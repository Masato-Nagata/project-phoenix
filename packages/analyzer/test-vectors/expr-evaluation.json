    { "id": "is_type_string", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.label" }, "type": "string" }, "expect": { "ok": true, "value": true } },
    { "id": "is_type_bool", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.flag" }, "type": "bool" }, "expect": { "ok": true, "value": true } },
    { "id": "is_type_null", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.nothing" }, "type": "null" }, "expect": { "ok": true, "value": true } },
    { "id": "is_type_array", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.items" }, "type": "array" }, "expect": { "ok": true, "value": true } },
    { "id": "is_type_object", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body" }, "type": "object" }, "expect": { "ok": true, "value": true } },
    { "id": "is_type_missing_true", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.nope" }, "type": "missing" }, "expect": { "ok": true, "value": true } },
    { "id": "is_type_missing_false_when_present", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.count" }, "type": "missing" }, "expect": { "ok": true, "value": false } },
    { "id": "is_type_wrong_type_no_error", "expr": { "op": "is_type", "ref": { "op": "input", "path": "requests[0].body.count" }, "type": "string" }, "expect": { "ok": true, "value": false } },

    { "id": "lookup_string_key", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": "y" } }, "expect": { "ok": true, "value": 9 } },
    { "id": "lookup_int_key", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": 5 } }, "expect": { "ok": true, "value": 50 } },
    { "id": "lookup_key_from_input", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "input", "path": "requests[0].body.label" } }, "expect": { "ok": true, "value": 7 } },
    { "id": "lookup_boolean_value", "expr": { "op": "lookup", "table": "flags", "key": { "op": "lit", "value": "on" } }, "expect": { "ok": true, "value": true } },
    { "id": "lookup_no_entry", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": "z" } }, "expect": { "ok": false, "error": { "code": "lookup_miss", "at": "" } } },
    { "id": "lookup_int_key_no_entry", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": 7 } }, "expect": { "ok": false, "error": { "code": "lookup_miss", "at": "" } } },
    { "id": "lookup_string_digit_is_not_int_key", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": "5" } }, "expect": { "ok": false, "error": { "code": "lookup_miss", "at": "" } } },
    { "id": "lookup_key_of_other_kind", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": true } }, "expect": { "ok": false, "error": { "code": "lookup_miss", "at": "" } } },
    { "id": "lookup_null_key", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "lit", "value": null } }, "expect": { "ok": false, "error": { "code": "lookup_miss", "at": "" } } },
    { "id": "lookup_key_error_propagates", "expr": { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "input", "path": "requests[0].body.nope" } }, "expect": { "ok": false, "error": { "code": "input_missing", "at": "/key" } } },
    { "id": "lookup_unknown_table_at_run_time", "expr": { "op": "lookup", "table": "no_such_table", "key": { "op": "lit", "value": "x" } }, "expect": { "ok": false, "error": { "code": "unknown_reference", "at": "" } } },

    { "id": "derived_cost", "expr": { "op": "derived", "name": "d_cost" }, "expect": { "ok": true, "value": 21 } },
    { "id": "derived_uses_earlier_derived", "expr": { "op": "derived", "name": "d_double" }, "expect": { "ok": true, "value": 42 } },
    { "id": "derived_error_pointer_in_declaration", "expr": { "op": "derived", "name": "d_bad" }, "expect": { "ok": false, "error": { "code": "division_by_zero", "at": "/derived/2/expr" } } },
    { "id": "derived_undeclared_at_run_time", "expr": { "op": "derived", "name": "no_such_value" }, "expect": { "ok": false, "error": { "code": "unknown_reference", "at": "" } } },
    { "id": "derived_forward_reference_at_run_time",
      "derived": [ { "name": "first", "expr": { "op": "derived", "name": "second" } }, { "name": "second", "expr": { "op": "lit", "value": 1 } } ],
      "expr": { "op": "derived", "name": "first" }, "expect": { "ok": false, "error": { "code": "unknown_reference", "at": "/derived/0/expr" } } },
    { "id": "derived_self_reference_at_run_time",
      "derived": [ { "name": "loop_a", "expr": { "op": "derived", "name": "loop_a" } } ],
      "expr": { "op": "derived", "name": "loop_a" }, "expect": { "ok": false, "error": { "code": "unknown_reference", "at": "/derived/0/expr" } } },

    { "id": "sum_each_qty", "expr": { "op": "sum", "over": "requests[0].body.items", "each": { "op": "elem", "path": "qty" } }, "expect": { "ok": true, "value": 6 } },
    { "id": "sum_each_product", "expr": { "op": "sum", "over": "requests[0].body.items", "each": { "op": "mul", "args": [ { "op": "elem", "path": "qty" }, { "op": "elem", "path": "w" } ] } }, "expect": { "ok": true, "value": 6 } },
    { "id": "sum_element_itself", "expr": { "op": "sum", "over": "requests[0].body.nums", "each": { "op": "elem", "path": "" } }, "expect": { "ok": true, "value": 6 } },
    { "id": "sum_each_uses_derived", "expr": { "op": "sum", "over": "requests[0].body.nums", "each": { "op": "add", "args": [ { "op": "elem", "path": "" }, { "op": "derived", "name": "d_cost" } ] } }, "expect": { "ok": true, "value": 69 } },
    { "id": "sum_each_uses_input", "expr": { "op": "sum", "over": "requests[0].body.nums", "each": { "op": "mul", "args": [ { "op": "elem", "path": "" }, { "op": "input", "path": "requests[0].body.count" } ] } }, "expect": { "ok": true, "value": 18 } },
    { "id": "count_all", "expr": { "op": "count", "over": "requests[0].body.nums" }, "expect": { "ok": true, "value": 3 } },
    { "id": "count_where", "expr": { "op": "count", "over": "requests[0].body.items", "where": { "op": "gt", "left": { "op": "elem", "path": "qty" }, "right": { "op": "lit", "value": 0 } } }, "expect": { "ok": true, "value": 2 } },
    { "id": "count_where_none", "expr": { "op": "count", "over": "requests[0].body.nums", "where": { "op": "lt", "left": { "op": "elem", "path": "" }, "right": { "op": "lit", "value": 0 } } }, "expect": { "ok": true, "value": 0 } },
    { "id": "sum_over_empty_array", "input": { "requests": [ { "body": { "e": [] } } ] }, "expr": { "op": "sum", "over": "requests[0].body.e", "each": { "op": "elem", "path": "" } }, "expect": { "ok": true, "value": 0 } },
    { "id": "count_over_empty_array", "input": { "requests": [ { "body": { "e": [] } } ] }, "expr": { "op": "count", "over": "requests[0].body.e" }, "expect": { "ok": true, "value": 0 } },
    { "id": "sum_over_missing", "expr": { "op": "sum", "over": "requests[0].body.nope", "each": { "op": "elem", "path": "" } }, "expect": { "ok": false, "error": { "code": "input_missing", "at": "/over" } } },
    { "id": "count_over_non_array", "expr": { "op": "count", "over": "requests[0].body.count" }, "expect": { "ok": false, "error": { "code": "array_expected", "at": "/over" } } },
    { "id": "sum_over_object_is_array_expected", "expr": { "op": "sum", "over": "requests[0].body", "each": { "op": "elem", "path": "" } }, "expect": { "ok": false, "error": { "code": "array_expected", "at": "/over" } } },
    { "id": "sum_elem_path_missing", "expr": { "op": "sum", "over": "requests[0].body.items", "each": { "op": "elem", "path": "zz" } }, "expect": { "ok": false, "error": { "code": "input_missing", "at": "/each" } } },
    { "id": "sum_each_not_integer", "expr": { "op": "sum", "over": "requests[0].body.nums", "each": { "op": "lit", "value": "s" } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/each" } } },
    { "id": "count_where_not_boolean", "expr": { "op": "count", "over": "requests[0].body.nums", "where": { "op": "lit", "value": 1 } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/where" } } },
    { "id": "sum_elem_is_object_type_error", "expr": { "op": "sum", "over": "requests[0].body.items", "each": { "op": "elem", "path": "" } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/each" } } },
    { "id": "sum_overflow_final_result", "input": { "requests": [ { "body": { "big": [9007199254740991, 1] } } ] }, "expr": { "op": "sum", "over": "requests[0].body.big", "each": { "op": "elem", "path": "" } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "sum_partial_total_overflows_even_if_final_is_in_range", "input": { "requests": [ { "body": { "big": [9007199254740991, 1, -1] } } ] }, "expr": { "op": "sum", "over": "requests[0].body.big", "each": { "op": "elem", "path": "" } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "is_type_elem_inside_count", "expr": { "op": "count", "over": "requests[0].body.items", "where": { "op": "is_type", "ref": { "op": "elem", "path": "w" }, "type": "int" } }, "expect": { "ok": true, "value": 3 } },
    { "id": "is_type_elem_missing_inside_count", "expr": { "op": "count", "over": "requests[0].body.items", "where": { "op": "is_type", "ref": { "op": "elem", "path": "zz" }, "type": "missing" } }, "expect": { "ok": true, "value": 3 } },
    { "id": "overflow_add_then_sub_back_in_range", "expr": { "op": "sub", "left": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 1 } ] }, "right": { "op": "lit", "value": 1 } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/left" } } },
    { "id": "overflow_mul_then_idiv_back_in_range", "expr": { "op": "idiv", "left": { "op": "mul", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 2 } ] }, "right": { "op": "lit", "value": 2 }, "round": "trunc" }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/left" } } },
    { "id": "overflow_nary_add_partial_sum_high", "expr": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 1 }, { "op": "lit", "value": -1 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "overflow_nary_add_partial_sum_low", "expr": { "op": "add", "args": [ { "op": "lit", "value": -9007199254740991 }, { "op": "lit", "value": -1 }, { "op": "lit", "value": 1 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "overflow_nary_add_late_partial_sum", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, { "op": "lit", "value": 2 }, { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 5 }, { "op": "lit", "value": -10 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "overflow_nary_mul_partial_product", "expr": { "op": "mul", "args": [ { "op": "lit", "value": 4503599627370496 }, { "op": "lit", "value": 2 }, { "op": "lit", "value": 0 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "overflow_nested_in_nary_add_reports_inner_node", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, { "op": "sub", "left": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 1 } ] }, "right": { "op": "lit", "value": 1 } } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/args/1/left" } } },
    { "id": "overflow_first_node_in_evaluation_order_wins", "expr": { "op": "sub", "left": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 9007199254740991 } ] }, "right": { "op": "mul", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 9007199254740991 } ] } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/left" } } },
    { "id": "overflow_negation_by_sub_then_add_back", "expr": { "op": "add", "args": [ { "op": "sub", "left": { "op": "lit", "value": 0 }, "right": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 1 } ] } }, { "op": "lit", "value": 1 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/args/0/right" } } },
    { "id": "overflow_inside_comparison_operand", "expr": { "op": "eq", "left": { "op": "sub", "left": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 1 } ] }, "right": { "op": "lit", "value": 1 } }, "right": { "op": "lit", "value": 0 } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/left/left" } } },
    { "id": "invalid_expression_unknown_operator", "expr": { "op": "pow", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 2 } }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_wrong_arity_one_arg", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 } ] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_wrong_arity_seventeen_args", "expr": { "op": "or", "args": [ { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true }, { "op": "lit", "value": true } ] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_missing_key", "expr": { "op": "not" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_extra_key", "expr": { "op": "lit", "value": 1, "extra": 2 }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_float_literal", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, { "op": "lit", "value": 1.5 } ] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/args/1", "cause": "structural" } } },
    { "id": "invalid_expression_unsafe_integer_literal", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, { "op": "lit", "value": 9007199254740993 } ] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/args/1", "cause": "structural" } } },
    { "id": "invalid_expression_bad_derived_name", "expr": { "op": "derived", "name": "Bad-Name" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_bad_table_name", "expr": { "op": "lookup", "table": "Flags", "key": { "op": "lit", "value": "on" } }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_uppercase_derived_name", "expr": { "op": "derived", "name": "D_cost" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_name_of_33_characters", "expr": { "op": "derived", "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_null_node", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, null ] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/args/1", "cause": "structural" } } },
    { "id": "invalid_expression_array_node", "expr": { "op": "not", "arg": [] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/arg", "cause": "structural" } } },
    { "id": "invalid_expression_bad_round_mode", "expr": { "op": "idiv", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 1 }, "round": "sideways" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_bad_input_path", "expr": { "op": "input", "path": "a..b" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_empty_input_path", "expr": { "op": "input", "path": "" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } },
    { "id": "invalid_expression_unvisited_branch_of_and", "expr": { "op": "and", "args": [ { "op": "lit", "value": false }, { "op": "zzz" } ] }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/args/1", "cause": "structural" } } },
    { "id": "invalid_expression_untaken_if_branch", "expr": { "op": "if", "cond": { "op": "lit", "value": true }, "then": { "op": "lit", "value": 1 }, "else": { "op": "add" } }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/else", "cause": "structural" } } },
    { "id": "invalid_expression_in_sum_over_empty_array", "expr": { "op": "sum", "over": "requests[0].body.empty", "each": { "op": "zzz" } }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "/each", "cause": "structural" } } },
    { "id": "invalid_expression_is_type_ref_not_input_or_elem", "expr": { "op": "is_type", "ref": { "op": "lit", "value": 1 }, "type": "int" }, "expect": { "ok": false, "error": { "code": "invalid_expression", "at": "", "cause": "structural" } } }
  ]
}
