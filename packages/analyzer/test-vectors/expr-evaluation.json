    { "id": "gt_negative", "expr": { "op": "gt", "left": { "op": "lit", "value": -1 }, "right": { "op": "lit", "value": -2 } }, "expect": { "ok": true, "value": true } },
    { "id": "lt_strings_are_type_error", "expr": { "op": "lt", "left": { "op": "lit", "value": "a" }, "right": { "op": "lit", "value": "b" } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/left" } } },
    { "id": "lt_bool_right_is_type_error", "expr": { "op": "lt", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": true } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/right" } } },
    { "id": "example_positive_count", "expr": { "op": "gt", "left": { "op": "input", "path": "requests[0].body.count" }, "right": { "op": "lit", "value": 0 } }, "expect": { "ok": true, "value": true } },

    { "id": "and_all_true", "expr": { "op": "and", "args": [ { "op": "lit", "value": true }, { "op": "lit", "value": true } ] }, "expect": { "ok": true, "value": true } },
    { "id": "and_one_false", "expr": { "op": "and", "args": [ { "op": "lit", "value": true }, { "op": "lit", "value": false }, { "op": "lit", "value": true } ] }, "expect": { "ok": true, "value": false } },
    { "id": "or_all_false", "expr": { "op": "or", "args": [ { "op": "lit", "value": false }, { "op": "lit", "value": false } ] }, "expect": { "ok": true, "value": false } },
