    { "id": "or_short_circuits_before_error", "expr": { "op": "or", "args": [ { "op": "lit", "value": true }, { "op": "idiv", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 0 }, "round": "floor" } ] }, "expect": { "ok": true, "value": true } },
    { "id": "and_short_circuits_before_type_error", "expr": { "op": "and", "args": [ { "op": "lit", "value": false }, { "op": "lit", "value": 1 } ] }, "expect": { "ok": true, "value": false } },
