{
  "schemaVersion": 1,
  "description": "Golden evaluation vectors for the Rule_Expression_Language. Neutral data only. A case may override input, derived or tables. expect is either {ok:true,value} or {ok:false,error:{code,at}}.",
  "input": {
    "requests": [
      { "method": "GET", "path": "/a", "pathParams": {},
        "body": { "count": 3, "label": "x", "ratio": 1.5, "flag": true, "nothing": null,
                  "items": [ { "qty": 2, "w": 5 }, { "qty": 4, "w": -1 }, { "qty": 0, "w": 7 } ],
                  "nums": [1, 2, 3] } }
    ],
    "preparation": []
  },
  "derived": [
    { "name": "d_cost", "expr": { "op": "mul", "args": [
        { "op": "input", "path": "requests[0].body.count" },
        { "op": "lookup", "table": "unit_cost_by_label", "key": { "op": "input", "path": "requests[0].body.label" } } ] } },
    { "name": "d_double", "expr": { "op": "add", "args": [ { "op": "derived", "name": "d_cost" }, { "op": "derived", "name": "d_cost" } ] } },
    { "name": "d_bad", "expr": { "op": "idiv", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 0 }, "round": "trunc" } }
  ],
  "tables": [
    { "name": "unit_cost_by_label", "entries": [ { "key": "x", "value": 7 }, { "key": "y", "value": 9 }, { "key": 5, "value": 50 } ] },
    { "name": "flags", "entries": [ { "key": "on", "value": true } ] }
  ],
  "cases": [
    { "id": "lit_int", "expr": { "op": "lit", "value": 5 }, "expect": { "ok": true, "value": 5 } },
    { "id": "lit_negative", "expr": { "op": "lit", "value": -5 }, "expect": { "ok": true, "value": -5 } },
    { "id": "lit_string", "expr": { "op": "lit", "value": "ab" }, "expect": { "ok": true, "value": "ab" } },
    { "id": "lit_true", "expr": { "op": "lit", "value": true }, "expect": { "ok": true, "value": true } },
    { "id": "lit_null", "expr": { "op": "lit", "value": null }, "expect": { "ok": true, "value": null } },

    { "id": "input_int", "expr": { "op": "input", "path": "requests[0].body.count" }, "expect": { "ok": true, "value": 3 } },
    { "id": "input_string", "expr": { "op": "input", "path": "requests[0].body.label" }, "expect": { "ok": true, "value": "x" } },
    { "id": "input_null", "expr": { "op": "input", "path": "requests[0].body.nothing" }, "expect": { "ok": true, "value": null } },
    { "id": "input_nested_index", "expr": { "op": "input", "path": "requests[0].body.items[1].w" }, "expect": { "ok": true, "value": -1 } },
    { "id": "input_real_passes_through", "expr": { "op": "input", "path": "requests[0].body.ratio" }, "expect": { "ok": true, "value": 1.5 } },
    { "id": "input_missing_name", "expr": { "op": "input", "path": "requests[0].body.nope" }, "expect": { "ok": false, "error": { "code": "input_missing", "at": "" } } },
    { "id": "input_missing_index", "expr": { "op": "input", "path": "requests[5].body.count" }, "expect": { "ok": false, "error": { "code": "input_missing", "at": "" } } },
    { "id": "input_prototype_name_is_missing", "expr": { "op": "input", "path": "requests[0].constructor" }, "expect": { "ok": false, "error": { "code": "input_missing", "at": "" } } },
    { "id": "input_array_is_type_error", "expr": { "op": "input", "path": "requests[0].body.items" }, "expect": { "ok": false, "error": { "code": "type_error", "at": "" } } },
    { "id": "input_object_is_type_error", "expr": { "op": "input", "path": "requests[0].body" }, "expect": { "ok": false, "error": { "code": "type_error", "at": "" } } },

    { "id": "add_three", "expr": { "op": "add", "args": [ { "op": "lit", "value": 2 }, { "op": "lit", "value": 3 }, { "op": "lit", "value": 4 } ] }, "expect": { "ok": true, "value": 9 } },
    { "id": "mul_three", "expr": { "op": "mul", "args": [ { "op": "lit", "value": 2 }, { "op": "lit", "value": 3 }, { "op": "lit", "value": 4 } ] }, "expect": { "ok": true, "value": 24 } },
    { "id": "sub_positive", "expr": { "op": "sub", "left": { "op": "lit", "value": 10 }, "right": { "op": "lit", "value": 3 } }, "expect": { "ok": true, "value": 7 } },
    { "id": "sub_negative", "expr": { "op": "sub", "left": { "op": "lit", "value": 3 }, "right": { "op": "lit", "value": 10 } }, "expect": { "ok": true, "value": -7 } },
    { "id": "mul_by_zero", "expr": { "op": "mul", "args": [ { "op": "lit", "value": 0 }, { "op": "lit", "value": -4 } ] }, "expect": { "ok": true, "value": 0 } },

    { "id": "add_overflow_high", "expr": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 1 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "add_reaches_max", "expr": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740990 }, { "op": "lit", "value": 1 } ] }, "expect": { "ok": true, "value": 9007199254740991 } },
    { "id": "mul_overflow", "expr": { "op": "mul", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 2 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "mul_partial_product_overflows_even_if_final_is_zero", "expr": { "op": "mul", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 0 } ] }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "sub_overflow_low", "expr": { "op": "sub", "left": { "op": "lit", "value": -9007199254740991 }, "right": { "op": "lit", "value": 1 } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "" } } },
    { "id": "sub_reaches_min", "expr": { "op": "sub", "left": { "op": "lit", "value": 0 }, "right": { "op": "lit", "value": 9007199254740991 } }, "expect": { "ok": true, "value": -9007199254740991 } },
    { "id": "overflow_reported_at_inner_node", "expr": { "op": "sub", "left": { "op": "lit", "value": 0 }, "right": { "op": "add", "args": [ { "op": "lit", "value": 9007199254740991 }, { "op": "lit", "value": 9007199254740991 } ] } }, "expect": { "ok": false, "error": { "code": "overflow", "at": "/right" } } },

    { "id": "idiv_7_2_floor", "expr": { "op": "idiv", "left": { "op": "lit", "value": 7 }, "right": { "op": "lit", "value": 2 }, "round": "floor" }, "expect": { "ok": true, "value": 3 } },
    { "id": "idiv_7_2_trunc", "expr": { "op": "idiv", "left": { "op": "lit", "value": 7 }, "right": { "op": "lit", "value": 2 }, "round": "trunc" }, "expect": { "ok": true, "value": 3 } },
    { "id": "idiv_7_2_ceil", "expr": { "op": "idiv", "left": { "op": "lit", "value": 7 }, "right": { "op": "lit", "value": 2 }, "round": "ceil" }, "expect": { "ok": true, "value": 4 } },
    { "id": "idiv_m7_2_floor", "expr": { "op": "idiv", "left": { "op": "lit", "value": -7 }, "right": { "op": "lit", "value": 2 }, "round": "floor" }, "expect": { "ok": true, "value": -4 } },
    { "id": "idiv_m7_2_trunc", "expr": { "op": "idiv", "left": { "op": "lit", "value": -7 }, "right": { "op": "lit", "value": 2 }, "round": "trunc" }, "expect": { "ok": true, "value": -3 } },
    { "id": "idiv_m7_2_ceil", "expr": { "op": "idiv", "left": { "op": "lit", "value": -7 }, "right": { "op": "lit", "value": 2 }, "round": "ceil" }, "expect": { "ok": true, "value": -3 } },
    { "id": "idiv_7_m2_floor", "expr": { "op": "idiv", "left": { "op": "lit", "value": 7 }, "right": { "op": "lit", "value": -2 }, "round": "floor" }, "expect": { "ok": true, "value": -4 } },
    { "id": "idiv_7_m2_trunc", "expr": { "op": "idiv", "left": { "op": "lit", "value": 7 }, "right": { "op": "lit", "value": -2 }, "round": "trunc" }, "expect": { "ok": true, "value": -3 } },
    { "id": "idiv_7_m2_ceil", "expr": { "op": "idiv", "left": { "op": "lit", "value": 7 }, "right": { "op": "lit", "value": -2 }, "round": "ceil" }, "expect": { "ok": true, "value": -3 } },
    { "id": "idiv_m7_m2_floor", "expr": { "op": "idiv", "left": { "op": "lit", "value": -7 }, "right": { "op": "lit", "value": -2 }, "round": "floor" }, "expect": { "ok": true, "value": 3 } },
    { "id": "idiv_m7_m2_trunc", "expr": { "op": "idiv", "left": { "op": "lit", "value": -7 }, "right": { "op": "lit", "value": -2 }, "round": "trunc" }, "expect": { "ok": true, "value": 3 } },
    { "id": "idiv_m7_m2_ceil", "expr": { "op": "idiv", "left": { "op": "lit", "value": -7 }, "right": { "op": "lit", "value": -2 }, "round": "ceil" }, "expect": { "ok": true, "value": 4 } },
    { "id": "idiv_exact_floor", "expr": { "op": "idiv", "left": { "op": "lit", "value": -6 }, "right": { "op": "lit", "value": 3 }, "round": "floor" }, "expect": { "ok": true, "value": -2 } },
    { "id": "idiv_exact_ceil", "expr": { "op": "idiv", "left": { "op": "lit", "value": 6 }, "right": { "op": "lit", "value": 3 }, "round": "ceil" }, "expect": { "ok": true, "value": 2 } },
    { "id": "idiv_zero_numerator", "expr": { "op": "idiv", "left": { "op": "lit", "value": 0 }, "right": { "op": "lit", "value": 5 }, "round": "floor" }, "expect": { "ok": true, "value": 0 } },
    { "id": "idiv_small_negative_ceil_is_zero", "expr": { "op": "idiv", "left": { "op": "lit", "value": -1 }, "right": { "op": "lit", "value": 5 }, "round": "ceil" }, "expect": { "ok": true, "value": 0 } },
    { "id": "idiv_by_zero_literal", "expr": { "op": "idiv", "left": { "op": "lit", "value": 5 }, "right": { "op": "lit", "value": 0 }, "round": "floor" }, "expect": { "ok": false, "error": { "code": "division_by_zero", "at": "" } } },
    { "id": "idiv_by_zero_from_input", "expr": { "op": "idiv", "left": { "op": "lit", "value": 5 }, "right": { "op": "input", "path": "requests[0].body.items[2].qty" }, "round": "trunc" }, "expect": { "ok": false, "error": { "code": "division_by_zero", "at": "" } } },
    { "id": "idiv_by_zero_nested_pointer", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, { "op": "idiv", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 0 }, "round": "floor" } ] }, "expect": { "ok": false, "error": { "code": "division_by_zero", "at": "/args/1" } } },

    { "id": "add_type_error_first_bad_operand", "expr": { "op": "add", "args": [ { "op": "lit", "value": "a" }, { "op": "lit", "value": "b" } ] }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/args/0" } } },
    { "id": "add_evaluation_error_beats_earlier_type_error", "expr": { "op": "add", "args": [ { "op": "lit", "value": "a" }, { "op": "idiv", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": 0 }, "round": "floor" } ] }, "expect": { "ok": false, "error": { "code": "division_by_zero", "at": "/args/1" } } },
    { "id": "add_bool_is_not_integer", "expr": { "op": "add", "args": [ { "op": "lit", "value": 1 }, { "op": "lit", "value": true } ] }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/args/1" } } },
    { "id": "add_real_operand", "expr": { "op": "add", "args": [ { "op": "input", "path": "requests[0].body.ratio" }, { "op": "lit", "value": 1 } ] }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/args/0" } } },
    { "id": "sub_null_operand", "expr": { "op": "sub", "left": { "op": "lit", "value": 1 }, "right": { "op": "lit", "value": null } }, "expect": { "ok": false, "error": { "code": "type_error", "at": "/right" } } },

