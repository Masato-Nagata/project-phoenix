# npm configuration for Project Phoenix (used inside the toolchain and runtime build containers only).
# Exact versions only (Requirement 20.7).
save-exact=true
# Refuse to install when Node.js or npm differ from package.json "engines".
engine-strict=true
# Do not run dependency lifecycle scripts (install, postinstall). Re-enable per package only after review.
ignore-scripts=true
# Lockfile is mandatory and committed.
package-lock=true
lockfile-version=3
registry=https://registry.npmjs.org/
strict-ssl=true
fund=false
update-notifier=false