  "boundary_cases": [
    { "id": "BC-001", "subtotal": 0,     "order_accepted": false, "expected_discount": 0,    "expected_shipping_fee": 500, "execution": "not_executed", "reason": "A zero subtotal cannot be produced by a valid order line. Every product price is at least 1 yen (legacy/sql/schema.sql declares CHECK (unit_price BETWEEN 1 AND 9999999); MySQL 5.7 parses but does not enforce CHECK, so this is the declared domain) and every quantity must be a positive integer (R3.13), so each valid line contributes at least 1 yen and any valid order has a subtotal of at least 1. A subtotal of 0 would need quantity 0, which is itself invalid input (DC-001, SCN-015), an empty line list, which is rejected as an invalid request (R3.10), or a 0-yen product outside the declared price domain; none of these tests the rule. The values are the rule outputs only. Reason approved by the project owner; the CHECK constraint is declared but not enforced by MySQL 5.7." },
    { "id": "BC-002", "subtotal": 999,   "order_accepted": false, "expected_discount": 0,    "expected_shipping_fee": 500, "expected_rejection": { "status": 400, "error": "Minimum order value not met" } },
