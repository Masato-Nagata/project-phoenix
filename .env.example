# Legacy MySQL — copy this file to .env and set your own values before starting containers.
# These placeholder values are sufficient for local development.
LEGACY_DB_ROOT_PASSWORD=changeme_root
LEGACY_DB_NAME=legacy_orders
LEGACY_DB_USER=legacy_app
LEGACY_DB_PASSWORD=changeme_app

# AI_Discovery_Loop (discovery-loop spec R19.4)
# The Mock_Provider (M1-M5) reads no credential. Leave the following empty.
# KIRO_API_KEY is used only by the Kiro_CLI_Provider after the M6/M7 approvals; it is passed only into the AI_Sandbox.
KIRO_API_KEY=
